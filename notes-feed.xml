---
layout: none
permalink: /notes/feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>Thoughtwax Notes</title>
    <description>Short notes by Emmet Connolly.</description>
    <link>https://thoughtwax.com/notes/</link>
    <atom:link href="https://thoughtwax.com/notes/feed.xml" rel="self" type="application/rss+xml" />
    {% assign notes = site.notes | sort: "note_id" | reverse %}
    {% for note in notes limit:50 %}
      <item>
        <title>Note {{ note.note_id }}</title>
        <description>{{ note.content | strip_html | xml_escape }}</description>
        <content:encoded>{{ note.content | xml_escape }}</content:encoded>
        <pubDate>{{ note.date | date: "%a, %d %b %Y %H:%M:%S %z" }}</pubDate>
        <link>https://thoughtwax.com{{ note.url }}</link>
        <guid isPermaLink="true">https://thoughtwax.com{{ note.url }}</guid>
      </item>
    {% endfor %}
  </channel>
</rss>
